# ============================================================
# agent-from-scratch 课程环境变量模板
# 用法：复制为仓库根目录的 .env，填入真实 key
#   cp agent-from-scratch/.env.example .env
# common.py 用 python-dotenv 的 load_dotenv() 自动加载（从运行目录向上查找 .env）
# 课程约定从仓库根目录运行：python agent-from-scratch/_shared/common.py
# ============================================================

# 必填：模型 API key
MODEL_API_KEY=sk-your-key-here

# 必填：OpenAI 兼容的 base_url（三选一，按你的供应商）
#   DeepSeek 官方：       https://api.deepseek.com
#   硅基流动 SiliconFlow： https://api.siliconflow.cn/v1
#   通义/阿里百炼：        https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_BASE_URL=https://api.deepseek.com

# 必填：模型名
#   DeepSeek：deepseek-chat（通用，00–19 用）/ deepseek-reasoner（reasoning，见 20）
MODEL_NAME=deepseek-chat

# 选填：采样温度（agent 任务建议 0~0.3 求稳定；默认 0.2）
#   注意：reasoning 模型（deepseek-reasoner / o 系列）会忽略 temperature，见 20-reasoning-agents
MODEL_TEMPERATURE=0.2

# ── 部分模块的额外配置（用到再解开注释）─────────────────────
# 04-rag：DeepSeek 官方【不提供】embedding 接口，需单独的 embedding 来源
#   方案 A（云）：硅基流动 / 通义 的 embedding API
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
#   方案 B（本地）：sentence-transformers 跑 bge，无需 key（装包即可）

# 12-eval：用 LangSmith 追踪时（可选）
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
